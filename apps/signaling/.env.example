# RemoteTab signaling environment — copy to .env and fill in.
# Never commit real secrets.

# Public origin clients use to reach this service (WSS base).
PUBLIC_ORIGIN=wss://localhost:8787

# HTTP listen port.
PORT=8787

# Comma-separated allowed browser origins for the PWA/extension.
ALLOWED_ORIGINS=

# Pairing/session TTLs (seconds).
PAIRING_TTL_SECONDS=300
RECONNECT_TTL_SECONDS=60

# TURN: shared secret used ONLY server-side to mint time-limited coturn credentials.
# Never shipped to clients. Empty disables the TURN credential endpoint.
TURN_SECRET=
TURN_URLS=

# debug | info | warn | error
LOG_LEVEL=info

# SQLite file for durable metadata (issue #018). Empty = in-memory (tests/dev).
DATABASE_URL=
